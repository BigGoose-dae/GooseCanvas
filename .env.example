# 平台预留
APP_NAME=Goose Canvas
APP_LOGO_URL=
APP_REPOSITORY_URL=https://github.com/goosecanvas/goosecanvas
APP_ADDR=:8080
DATA_DIR=./data

# 火山方舟：图片、视频共用
VOLCENGINE_API_KEY=
VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com

# 火山 TOS（与上面的方舟 API Key 是两套凭证）
TOS_ENDPOINT=https://tos-cn-beijing.volces.com
TOS_REGION=cn-beijing
TOS_BUCKET=
TOS_ACCESS_KEY=
TOS_SECRET_KEY=
TOS_PREFIX=goose-canvas
TOS_PRESIGN_TTL=24h

# Worker
WORKER_POLL_INTERVAL=3s
WORKER_TASK_TIMEOUT=30m
