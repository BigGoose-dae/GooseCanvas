# 平台预留
APP_NAME=Goose Canvas
APP_LOGO_URL=
APP_REPOSITORY_URL=https://github.com/BigGoose-dae/GooseCanvas
APP_ADDR=127.0.0.1:8080
DATA_DIR=./data

# 火山方舟服务地址（凭证请在 Web 设置页配置）
VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com
VOLCENGINE_ASSETS_PROJECT_NAME=default
VOLCENGINE_ASSETS_BASE_URL=https://ark.cn-beijing.volcengineapi.com
VOLCENGINE_AUDIO_ENDPOINT=https://openspeech.bytedance.com/api/v3/tts/create

# Worker
WORKER_POLL_INTERVAL=3s
WORKER_TASK_TIMEOUT=30m
